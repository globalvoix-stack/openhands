# ============================================
# THINKSOFT FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Use these for Vercel or other frontend deployments
# Copy this file to .env and fill in your values

# ============================================
# BACKEND CONNECTION (REQUIRED)
# ============================================
# Your backend API URL (without protocol)
# Example for production: api.thinksoft.yourdomain.com
# Example for local dev: localhost:3000
VITE_BACKEND_HOST=your-backend-api.yourdomain.com

# Backend base URL (same as above, without protocol)
VITE_BACKEND_BASE_URL=your-backend-api.yourdomain.com

# ============================================
# TLS/SSL CONFIGURATION
# ============================================
# Use HTTPS/WSS for backend connections
# Set to "true" for production, "false" for local development
VITE_USE_TLS=true

# Skip TLS certificate verification
# ONLY use "true" for development with self-signed certificates
# MUST be "false" for production
VITE_INSECURE_SKIP_VERIFY=false

# ============================================
# FRONTEND PORT (Optional)
# ============================================
# Port for local development (Vercel handles this automatically)
VITE_FRONTEND_PORT=3001

# ============================================
# DEVELOPMENT SETTINGS (Optional)
# ============================================
# Enable API mocking with MSW (Mock Service Worker)
# Set to "false" for production, can be "true" for local testing
VITE_MOCK_API=false

# Simulate SaaS mode in development
# Set to "false" for production
VITE_MOCK_SAAS=false

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================
# GitHub token for repository access (used in some features)
# Get from: https://github.com/settings/tokens
# VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
