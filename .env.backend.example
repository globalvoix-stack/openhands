# ============================================
# THINKSOFT BACKEND ENVIRONMENT VARIABLES
# ============================================
# Use these for Railway, Render, DigitalOcean, or other backend deployments
# Copy this file to .env and fill in your actual values

# ============================================
# LLM CONFIGURATION (REQUIRED)
# ============================================
# Your LLM API Key - YOU MUST PROVIDE THIS
# For Anthropic Claude: Get from https://console.anthropic.com/
# For OpenAI: Get from https://platform.openai.com/api-keys
LLM_API_KEY=YOUR_API_KEY_HERE

# LLM Model to use
# Anthropic options: anthropic/claude-sonnet-4-20250514, anthropic/claude-opus-4-5-20251101
# OpenAI options: openai/gpt-4o, openai/gpt-4-turbo
LLM_MODEL=anthropic/claude-sonnet-4-20250514

# Optional: Custom LLM base URL (for proxies or custom endpoints)
# LLM_BASE_URL=https://api.anthropic.com

# Optional: LLM provider override
# LLM_PROVIDER=anthropic

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.0

# Max tokens for LLM responses
# LLM_MAX_TOKENS=4096

# ============================================
# SANDBOX/RUNTIME CONFIGURATION (REQUIRED)
# ============================================
# Runtime type: docker (recommended), local, or remote
RUNTIME=docker

# Sandbox container image
SANDBOX_RUNTIME_CONTAINER_IMAGE=ghcr.io/openhands/runtime:main-nikolaik

# Sandbox timeout in seconds
SANDBOX_TIMEOUT=120

# Run as openhands user (recommended for security)
RUN_AS_OPENHANDS=true

# ============================================
# SERVER CONFIGURATION
# ============================================
# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

# Frontend port (if running frontend locally)
FRONTEND_PORT=3001

# Frontend directory (if serving frontend from backend)
# FRONTEND_DIRECTORY=./frontend/build

# ============================================
# WORKSPACE AND STORAGE
# ============================================
# Base directory for agent workspaces
WORKSPACE_BASE=./workspace

# File store path for persistent storage
FILE_STORE_PATH=/tmp/thinksoft_file_store

# Enable file store
ENABLE_FILE_STORE=true

# ============================================
# SECURITY SETTINGS
# ============================================
# Confirmation mode: enabled or disabled
CONFIRMATION_MODE=enabled

# Security analyzer: llm or invariant
SECURITY_ANALYZER=llm

# ============================================
# OPTIONAL: ADDITIONAL LLM CONFIGS
# ============================================
# Editor LLM (for code editing tasks)
# EDITOR_LLM_MODEL=anthropic/claude-sonnet-4-20250514
# EDITOR_LLM_API_KEY=YOUR_API_KEY_HERE

# Condenser LLM (for summarization, can use cheaper model)
# CONDENSER_LLM_MODEL=anthropic/claude-3-5-haiku-20241022
# CONDENSER_LLM_API_KEY=YOUR_API_KEY_HERE

# ============================================
# OPTIONAL: MCP (Model Context Protocol) SERVERS
# ============================================
# Tavily API key for web search capabilities
# Get from: https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: GITHUB INTEGRATION
# ============================================
# GitHub token for repository operations
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: AGENT CONFIGURATION
# ============================================
# Enable memory for agents
MEMORY_ENABLED=true

# Max memory threads
MEMORY_MAX_THREADS=2

# Enable function calling
FUNCTION_CALLING_LLM_ENABLED=true

# Enable microagents
MICRO_AGENT_ENABLED=true

# ============================================
# OPTIONAL: CONDENSER SETTINGS
# ============================================
# Enable default condenser for conversation history management
ENABLE_DEFAULT_CONDENSER=true

# Max condenser size (in messages)
CONDENSER_MAX_SIZE=240

# ============================================
# OPTIONAL: LOGGING AND DEBUGGING
# ============================================
# Log all events (useful for debugging)
LOG_ALL_EVENTS=true

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ============================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================
# Remote runtime settings (if using remote runtime)
# REMOTE_RUNTIME_API_URL=https://runtime.eval.all-hands.dev
# REMOTE_RUNTIME_API_KEY=your_remote_runtime_key

# Resource factor for remote runtime
# REMOTE_RUNTIME_RESOURCE_FACTOR=1

# Max budget per task (in dollars)
# MAX_BUDGET_PER_TASK=10.0

# ============================================
# OPTIONAL: DATABASE (if using enterprise features)
# ============================================
# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/thinksoft

# ============================================
# OPTIONAL: REDIS (if using enterprise features)
# ============================================
# Redis connection
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# DOCKER DEPLOYMENT NOTES
# ============================================
# If deploying with Docker, you may need to mount:
# - Docker socket: -v /var/run/docker.sock:/var/run/docker.sock
# - Workspace: -v $(pwd)/workspace:/workspace
# - File store: -v $(pwd)/.thinksoft:/.thinksoft
#
# Example Docker run command:
# docker run -it --rm \
#   --env-file .env \
#   -v /var/run/docker.sock:/var/run/docker.sock \
#   -v $(pwd)/workspace:/workspace \
#   -v $(pwd)/.thinksoft:/.thinksoft \
#   -p 3000:3000 \
#   your-thinksoft-image
